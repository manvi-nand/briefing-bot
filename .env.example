# Copy to .env and fill in. Never commit .env.

# ---------- Channel ----------
PRIMARY_CHANNEL=telegram

# ---------- Telegram ----------
# from @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# leave empty at first: message the bot and it replies with your chat id
TELEGRAM_CHAT_ID=
# polling (laptop, no public URL) | webhook (deployed; needs PUBLIC_BASE_URL)
TELEGRAM_MODE=polling
# any random string (webhook mode only)
TELEGRAM_WEBHOOK_SECRET=

# ---------- Gemini ----------
# aistudio.google.com -> Get API key
GEMINI_API_KEY=
# cheaper: gemini-3.5-flash-lite ; smarter: gemini-3.1-pro-preview
LLM_MODEL=gemini-3.8-flash
# minimal | low | medium | high
LLM_THINKING_CHAT=low
LLM_THINKING_SCRIPT=medium
LLM_THINKING_RANK=low

# ---------- Sarvam ----------
# dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh
# later: te-IN, hi-IN, kn-IN ... for the regional track
SARVAM_TTS_LANGUAGE=en-IN

# ---------- Jev (TypeSafe) - optional, phase 3 ----------
# switch to jev once TYPESAFE_API_KEY is set
RANKER=llm
TYPESAFE_API_KEY=

# ---------- Data / ops ----------
DATABASE_URL=postgresql+asyncpg://helper:helper@localhost:5544/helper
TIMEZONE=Asia/Kolkata
BRIEFING_TIME=07:30
BRIEFING_MINUTES=7
DAILY_BUDGET_USD=1.00
PUBLIC_BASE_URL=
USER_INTERESTS="AI/ML engineer in Bangalore. Interested in LLMs, agents, RAG, evals, open-source models, Indian AI ecosystem (e.g. Sarvam), AI infra, and major world news."

# ---------- Uptime alerting (optional, recommended once deployed) ----------
# The app can't message you if it's the thing that's down, so this pings OUT to an external monitor
# instead -- if the pings stop arriving, the monitor notices and alerts you by email/SMS/etc., outside
# Telegram. Free: create an account at healthchecks.io, add a check expecting a ping every ~10 min
# (for HEARTBEAT_URL) and optionally a second one expecting one ping/day around your briefing time (for
# BRIEFING_HEARTBEAT_URL), then paste each check's ping URL below. Leave blank to disable.
HEARTBEAT_URL=
BRIEFING_HEARTBEAT_URL=

# ---------- WhatsApp (later; code is in app/channels/whatsapp.py) ----------
# PRIMARY_CHANNEL=whatsapp plus WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_BUSINESS_ACCOUNT_ID,
# WHATSAPP_APP_SECRET, WHATSAPP_WEBHOOK_VERIFY_TOKEN, MY_WHATSAPP_NUMBER. See SETUP_REQUIREMENTS.md.
